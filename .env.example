
GEMINI_API_KEY=your-gemini-api-key

# Optional settings (these are the defaults)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash   # tried if the main model is overloaded (503)
# TOP_K=5
# MIN_SCORE=0.5
# DATA_DIR=./data
# VISION_PROVIDER=gemini   # gemini | claude | none (how charts and images are described)
# ANTHROPIC_API_KEY=         # only if VISION_PROVIDER=claude (also pip install anthropic)
