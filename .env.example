
# Pick the provider that answers questions. With no key the app runs in search-only mode.
OPENAI_API_KEY=your-openai-api-key               # https://platform.openai.com/api-keys
# GEMINI_API_KEY=your-gemini-api-key             # alternative: https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=your-openrouter-api-key     # alternative provider
# LLM_PROVIDER=auto                              # auto | openai | gemini | openrouter
#                                                # (auto: OpenAI if its key is set, else Gemini, else OpenRouter)

# OpenAI settings (these are the defaults)
# OPENAI_MODEL=gpt-4o-mini                       # answers, follow-up rewriting, image judging, figure captions
# OPENAI_FALLBACK_MODEL=                         # optional: tried if the main model is busy
# OPENAI_REASONING=                              # optional: low | medium | high (gpt-5 / o-series models only)
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe        # voice: speech to text (whisper-1 is the fallback)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts               # voice: text to speech
# OPENAI_VOICE=alloy                             # voice: alloy, nova, shimmer, echo, onyx, ...

# Gemini settings (these are the defaults)
# GEMINI_MODEL=gemini-3.8-flash                  # answers, follow-up rewriting, image judging, figure captions
# GEMINI_FALLBACK_MODEL=                         # optional, e.g. gemini-3.6-flash: tried if the main model is busy
# GEMINI_REASONING=                              # optional: low | medium | high (empty = the model's default)
# GEMINI_STT_MODEL=gemini-3.8-flash              # voice: speech to text
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts          # voice: text to speech
# GEMINI_VOICE=Kore                              # voice: any Gemini prebuilt voice name (Puck, Charon, ...)

# Other settings (these are the defaults). The OPENROUTER_* ones only apply when OpenRouter answers.
# OPENROUTER_MODEL=openai/gpt-4o-mini        # any OpenRouter model id
# OPENROUTER_FALLBACK_MODEL=                     # optional: tried if the main model is overloaded
# VISION_PROVIDER=auto                           # auto | none (describe charts and images)
# VISION_MODEL=                                  # defaults to the answer model; must accept images
# OPENROUTER_SITE_URL=http://localhost:8501      # shown on openrouter.ai for app attribution
# OPENROUTER_APP_NAME=Document Q&A
# TOP_K=5
# MIN_SCORE=0.5
# DATA_DIR=./data

# Web fallback: when the documents don't have the answer, answer from Google Search instead
# (Gemini's "Grounding with Google Search"; needs GEMINI_API_KEY, even if OpenRouter answers).
# WEB_SEARCH=true                                # true | false
# WEB_SEARCH_MODEL=                              # defaults to GEMINI_MODEL; must support the google_search tool

# Images and conversation memory
# SEGMENTER=sam                                  # sam | none (none = crop without SAM)
# SAM_WEIGHTS=                                   # default: DATA_DIR/models/mobile_sam.pt (auto-download)
# IMAGE_MIN_SCORE=0.45                           # caption similarity needed before a figure is considered
# MAX_IMAGES=2                                   # most figures sent to the model for one question
# HELPER_MODEL=                                  # small model for follow-up rewriting and image judging
# MEMORY_MESSAGES=6                              # earlier messages used to understand follow-ups

# Voice assistant (local engines need: pip install -r requirements-voice.txt; OpenAI and Gemini need nothing extra)
# With an OpenAI (or else Gemini) key, voice uses that service by default. Without a key it runs locally.
# VOICE_STT=openai                               # openai | gemini | whisper | none   (speech to text)
# WHISPER_MODEL=base                             # tiny | base | small | ... (bigger = more accurate, slower)
# WHISPER_DEVICE=cpu                             # cpu | cuda
# WHISPER_COMPUTE=int8                           # int8 | float16 | float32
# VOICE_LANGUAGE=                                # e.g. en, de; empty = detect the spoken language
# VOICE_TTS=openai                               # openai | gemini | piper | pyttsx3 | none   (text to speech)
# PIPER_VOICE=                                   # default: DATA_DIR/models/piper/en_US-lessac-medium.onnx
# VOICE_AUTOPLAY=true                            # play a spoken answer as soon as it is ready
